# Receiver connection. Store RATIFY_RECEIVER_TOKEN as a Maritime secret.
RATIFY_RECEIVER_MCP_URL=https://receiver.example/mcp/
RATIFY_PRESENTATION_URL=https://receiver.example/presentations
RATIFY_RECEIVER_TOKEN=replace-with-transport-token

# Credential required by the public demo console when calling POST /chat.
RATIFY_DEMO_TOKEN=replace-with-demo-console-token

# Signed public delegation and matching agent private material. Store all three
# as Maritime secrets even though the delegation itself is not a private key.
RATIFY_DELEGATION_B64=replace-with-base64-encoded-delegation
RATIFY_AGENT_ED25519_PRIVATE_B64=replace-with-base64
RATIFY_AGENT_ML_DSA_65_PRIVATE_B64=replace-with-base64

# Default acceptance path: no paid model or provider credential.
RATIFY_MODEL_MODE=deterministic

# Optional production path through Maritime's OpenAI-compatible proxy.
# RATIFY_MODEL_MODE=production
# RATIFY_MODEL_ID=openai:gpt-5-mini
# OPENAI_API_KEY=injected-by-maritime-or-your-secret
# OPENAI_BASE_URL=https://api.maritime.sh/api/llm/v1
